# ---------------------------------------------------------------- runtime
ENV=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
INSTITUTION_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- MongoDB (primary database)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=eedi_lms
# Dev/CI only: run against an in-process MongoDB-compatible store when no server is reachable.
# Refused in production.
USE_INMEMORY_DB=false

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=false

# ---------------------------------------------------------------- JWT / sessions
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------- auth policy
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute
OTP_TTL_MINUTES=10
PUBLIC_SIGNUP_ENABLED=true
SELF_SIGNUP_ROLES=STUDENT

# ---------------------------------------------------------------- object storage (Amazon S3)
# STORAGE_DRIVER=s3 requires the four AWS values below. `local` keeps files on disk behind
# HMAC-signed expiring URLs so the app runs with no AWS account.
STORAGE_DRIVER=local
S3_BUCKET=eedi-lms-private
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900
LOCAL_STORAGE_ROOT=./.storage

# ---------------------------------------------------------------- AI
# AI_PROVIDER=anthropic|openai needs AI_API_KEY. `mock` is a deterministic, evidence-grounded
# evaluator used for local development and tests.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
STT_PROVIDER=mock
STT_API_KEY=
AI_REQUIRE_EVIDENCE=true

# ---------------------------------------------------------------- email
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@eedilms.app
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------- push notifications
FCM_ENABLED=false
FCM_SERVER_KEY=

# ---------------------------------------------------------------- background worker
QUEUE_NAME=eedi:jobs
QUEUE_EAGER=false
JOB_MAX_ATTEMPTS=3
REPORT_ASYNC_ROW_THRESHOLD=500

# ---------------------------------------------------------------- business rules
ATTENDANCE_DEFAULTER_THRESHOLD=75
CERTIFICATE_MIN_ATTENDANCE=75
CERTIFICATE_MIN_AVG_SCORE=60
WEAK_STUDENT_THRESHOLD=50
EVALUATION_EDIT_WINDOW_HOURS=72
BULK_IMPORT_MAX_ROWS=5000
SCORING_VERSION=1.0.0
EEDI_TRAINER_WEIGHT=0.6
EEDI_AI_WEIGHT=0.4

# ---------------------------------------------------------------- dev helpers
ALLOW_DEV_ENDPOINTS=true

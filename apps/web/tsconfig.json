{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@games/*": ["../game/*"],
      "@games": ["../game/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../game/**/*.ts",
    "../game/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "../game/winners-creek",
    "../game/email-games",
    "../game/games",
    "../game/Listening skills",
    "../game/pubspeak"
  ]
}


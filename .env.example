# EEDI LMS / Winners Creek Root Environment Configuration
# Copy this to .env for local orchestration or see apps/api/.env.example and apps/web/.env.local.example

# FastAPI Backend Service (Port 8000)
API_HOST=127.0.0.1
API_PORT=8000

# Next.js Web Frontend (Port 3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_PROXY_TARGET=http://127.0.0.1:8000

# PostgreSQL Database (Authoritative)
POSTGRES_DB=cnc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache / Session Store
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (mock | anthropic | openai | huggingface)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=45
